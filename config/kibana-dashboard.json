          "aggs": [
            {
              "id": "2",
              "enabled": true,
              "type": "count",
              "schema": "metric",
              "params": {}
            },
            {
              "id": "3",
              "enabled": true,
              "type": "terms",
              "schema": "segment",
              "params": {
                "field": "service",
                "size": 10
              }
            }
          ]
