# Honeypot Framework - Environment Variables Template
# Copy this file to .env and update with your values
# IMPORTANT: Never commit .env to version control!

################################################################################
# SECURITY & CREDENTIALS
################################################################################

# JWT Token Configuration
JWT_SECRET_KEY=change_me_to_a_random_string_in_production
JWT_ALGORITHM=HS256
TOKEN_EXPIRATION_HOURS=24

# RBAC Bootstrap Admin (created on first start when the users table is empty).
# If ADMIN_PASSWORD is left blank, a strong random one is generated and logged
# ONCE at startup -- copy it from the logs and change it immediately.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Elasticsearch Credentials
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_SSL=true
ELASTICSEARCH_VERIFY_CERTS=true

# Elasticsearch System Users (for internal services)
LOGSTASH_ES_USER=logstash_system
LOGSTASH_ES_PASSWORD=changeme
KIBANA_ES_USER=kibana_system
KIBANA_ES_PASSWORD=changeme

# API Authentication
API_RATE_LIMIT=1000
API_RATE_LIMIT_WINDOW=3600
API_KEY_EXPIRATION_DAYS=90

# SSL/TLS Certificates
SSL_CERT_DIR=/etc/honeypot-framework/ssl
SSL_CA_CERT_PATH=/etc/honeypot-framework/ssl/ca-cert.pem
SSL_ELASTICSEARCH_KEY_PATH=/etc/honeypot-framework/ssl/elasticsearch-key.pem
SSL_ELASTICSEARCH_CERT_PATH=/etc/honeypot-framework/ssl/elasticsearch-cert.pem
SSL_KIBANA_KEY_PATH=/etc/honeypot-framework/ssl/kibana-key.pem
SSL_KIBANA_CERT_PATH=/etc/honeypot-framework/ssl/kibana-cert.pem
SSL_API_KEY_PATH=/etc/honeypot-framework/ssl/api-key.pem
SSL_API_CERT_PATH=/etc/honeypot-framework/ssl/api-cert.pem

################################################################################
# API SERVER CONFIGURATION
################################################################################

# Flask/API Server
API_HOST=0.0.0.0
API_PORT=8443
API_DEBUG=false
API_WORKERS=4
API_TIMEOUT=30

# Flask Session
SECRET_KEY=change_me_to_a_random_string_for_session
SESSION_LIFETIME=86400

################################################################################
# DATABASE CONFIGURATION
################################################################################

# SQLite (local alerts database)
ALERTS_DB_PATH=/var/lib/honeypot/alerts.db
ALERTS_DB_BACKUP_DIR=/var/lib/honeypot/backups

# PostgreSQL (optional, for larger deployments)
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=honeypot
# DB_PASSWORD=changeme
# DB_NAME=honeypot_framework

################################################################################
# LOGGING CONFIGURATION
################################################################################

# Log Level
LOG_LEVEL=INFO

# Log Locations
LOG_DIR=/var/log/honeypot
API_LOG_FILE=/var/log/honeypot/api.log
AUDIT_LOG_FILE=/var/log/honeypot/audit.log
SECURITY_LOG_FILE=/var/log/honeypot/security.log
ALERT_LOG_FILE=/var/log/honeypot/alerts.log

# Log Retention (days)
LOG_RETENTION_DAYS=90

################################################################################
# HONEYPOT SERVICES
################################################################################

# Cowrie SSH Honeypot
COWRIE_HOST=127.0.0.1
COWRIE_PORT=2222
COWRIE_LOG_FILE=/home/cowrie/cowrie/var/log/cowrie/cowrie.log

# OpenCanary Multi-Service
OPENCANARY_HOST=127.0.0.1
OPENCANARY_LOG_FILE=/var/tmp/opencanary.log

# Logstash
LOGSTASH_HOST=localhost
LOGSTASH_PORT=5000
LOGSTASH_CONFIG=/etc/logstash/conf.d/honeypot.conf

################################################################################
# MONITORING & ALERTS
################################################################################

# Prometheus
PROMETHEUS_HOST=localhost
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_DAYS=15

# Alertmanager
ALERTMANAGER_HOST=localhost
ALERTMANAGER_PORT=9093

# Alert Thresholds
ALERT_HIGH_RISK_THRESHOLD=0.8
ALERT_MEDIUM_RISK_THRESHOLD=0.5
ALERT_LOW_RISK_THRESHOLD=0.2

################################################################################
# NOTIFICATIONS
################################################################################

# Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=honeypot-alerts@example.com
SMTP_TLS=true

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#security-alerts
SLACK_BOT_NAME=Honeypot Alert Bot

# Discord Notifications
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/YOUR/WEBHOOK
DISCORD_CHANNEL_ID=123456789

################################################################################
# THREAT INTELLIGENCE
################################################################################

# AbuseIPDB Integration
ABUSEIPDB_API_KEY=your_api_key_here
ABUSEIPDB_ENABLED=true

# VirusTotal Integration
VIRUSTOTAL_API_KEY=your_api_key_here
VIRUSTOTAL_ENABLED=false

# GreyNoise Integration
GREYNOISE_API_KEY=your_api_key_here
GREYNOISE_ENABLED=false

# MaxMind GeoIP
GEOIP_DB_PATH=/usr/share/GeoIP/GeoLite2-City.mmdb

################################################################################
# AWS CONFIGURATION (for Phase 2 deployment)
################################################################################

# AWS Region
AWS_REGION=us-east-1
AWS_PROFILE=default

# S3 Backup
S3_BUCKET_NAME=honeypot-framework-backups
S3_BACKUP_PREFIX=backups/
S3_ENABLE_ENCRYPTION=true
S3_ENCRYPTION_KEY_ID=arn:aws:kms:us-east-1:ACCOUNT:key/KEY_ID

# CloudWatch
CLOUDWATCH_LOG_GROUP=/honeypot/framework
CLOUDWATCH_ENABLED=false

# SNS Notifications (AWS)
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:ACCOUNT:honeypot-alerts

################################################################################
# DEVELOPMENT & DEBUGGING
################################################################################

# Debug Mode (NEVER enable in production!)
DEBUG=false
DEBUG_SQL=false
DEBUG_REQUESTS=false

# Testing
TESTING=false
TEST_DB_PATH=:memory:

# Performance Monitoring
ENABLE_PROFILING=false
ENABLE_METRICS=true

################################################################################
# ADVANCED CONFIGURATION
################################################################################

# Machine Learning Models
ML_MODEL_DIR=/var/lib/honeypot/models
ML_ANOMALY_CONTAMINATION=0.1
ML_THREAT_THRESHOLD=0.5

# Attack Correlation
CORRELATION_TIME_WINDOW_SECONDS=3600
CORRELATION_MIN_EVENTS=3

# Data Retention
DATA_RETENTION_DAYS=90
ARCHIVE_DATA_TO_COLD_STORAGE=true
COLD_STORAGE_AFTER_DAYS=30

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION=true

################################################################################
# IMPORTANT NOTES
################################################################################

# 1. SECURITY
#    - Generate a strong JWT_SECRET_KEY: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#    - Generate a strong SECRET_KEY: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#    - Change all default passwords immediately
#    - Never commit this file to version control
#    - Restrict file permissions: chmod 600 .env
#    - Use a secrets management system in production (AWS Secrets Manager, HashiCorp Vault, etc.)

# 2. PRODUCTION DEPLOYMENT
#    - Use SSL/TLS certificates from Let's Encrypt or your CA
#    - Enable HTTPS_ONLY=true
#    - Use strong, unique passwords
#    - Enable database encryption
#    - Configure backups and disaster recovery
#    - Set up monitoring and alerting
#    - Enable audit logging

# 3. COMPLIANCE
#    - Ensure GDPR/CCPA compliance for user data
#    - Enable data encryption (at rest and in transit)
#    - Configure log retention per compliance requirements
#    - Enable audit trails for compliance reporting
#    - Document all configuration changes

# 4. SUPPORT
#    - Read docs/API-SECURITY.md for API authentication guide
#    - Check docs/SETUP.md for initial configuration
#    - Review docs/SECURITY-HARDENING.md for production hardening
#    - Run: python3 scripts/validate-config.py to verify settings
