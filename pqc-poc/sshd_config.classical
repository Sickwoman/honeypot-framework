# =============================================================================
# CLASSICAL SSH honeypot -- sshd configuration (A/B control variant)
# =============================================================================
# Offers ONLY classical (pre-quantum) key exchange. This is the experimental
# control: every connection here negotiates a classical kex, so comparing its
# `kex_negotiated` events against the hybrid variant isolates the effect of
# offering post-quantum algorithms.
# =============================================================================

Port 2222
AddressFamily inet
ListenAddress 0.0.0.0

# --- Classical key exchange ONLY (no ML-KEM / SNTRUP) ---
KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,ecdh-sha2-nistp256,diffie-hellman-group14-sha256

HostKey /etc/ssh/keys/ssh_host_ed25519_key
HostKeyAlgorithms ssh-ed25519
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com
MACs    hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com

# --- Honeypot posture: complete the KEX, log it, then let auth fail ---
PermitRootLogin            no
PasswordAuthentication     yes
PermitEmptyPasswords       no
PubkeyAuthentication       no
KbdInteractiveAuthentication no
MaxAuthTries               3
MaxSessions                2
LoginGraceTime             20
AllowTcpForwarding         no
AllowAgentForwarding       no
X11Forwarding              no
PermitTunnel               no
PermitTTY                  no
PermitUserRC               no
Subsystem sftp             /bin/false

LogLevel       DEBUG1
SyslogFacility AUTH
StrictModes    yes
