# =============================================================================
# PQC relay front-end -- sshd configuration
# =============================================================================
# Terminates the post-quantum hybrid handshake, "accepts" the login (any user
# via libnss-ato, any password via pam_permit -- creds are captured by the PAM
# hook first), then ForceCommand-relays into Cowrie. The front-end grants NO
# shell of its own: the attacker only ever reaches Cowrie's fake shell.
# =============================================================================

Port 2225
AddressFamily inet
ListenAddress 0.0.0.0

# Post-quantum hybrid key exchange -- the whole reason the front-end exists.
KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512@openssh.com,curve25519-sha256

HostKey /etc/ssh/keys/ssh_host_ed25519_key
HostKeyAlgorithms ssh-ed25519
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com
MACs    hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com

# --- Accept + capture, then hand off ---------------------------------------
UsePAM                       yes
PasswordAuthentication       yes
PermitEmptyPasswords         yes
PubkeyAuthentication         no
KbdInteractiveAuthentication no
# Let them try root too (max data fidelity). ForceCommand + cap-drop +
# no-new-privileges + no forwarding contain the session to the Cowrie relay,
# even though the mapped OS identity is the unprivileged `sensor` account.
PermitRootLogin              yes
MaxAuthTries                 6
LoginGraceTime               30

# Every accepted login is forced straight into the Cowrie relay.
ForceCommand                 /usr/local/bin/relay.sh
AllowTcpForwarding           no
AllowAgentForwarding         no
X11Forwarding                no
PermitTunnel                 no
PermitTTY                    yes        # keep a PTY so Cowrie's shell is interactive
Subsystem sftp               /bin/false

LogLevel       DEBUG1
SyslogFacility AUTH
StrictModes    yes
